#!/usr/sbin/nft -f

flush ruleset

include "/etc/nftables.d/*.conf"

table inet firewall {

    #
    # NAT
    #

    chain dstnat {
        type nat hook prerouting priority dstnat; policy accept;

        iifname "ppp0" jump dstnat_wan
    }

    chain dstnat_wan {
        # Explicit port-forward rules take precedence over Full Cone mappings
        tcp dport 8809 dnat ip to 192.168.88.254:8809
        udp dport 8809 dnat ip to 192.168.88.254:8809

        # Full Cone inbound mapping for UDP
        meta nfproto ipv4 meta l4proto udp fullcone
    }

    chain srcnat {
        type nat hook postrouting priority srcnat; policy accept;

        oifname "ppp0" jump srcnat_wan
    }

    chain srcnat_wan {
        # Native/bypassed UDP traffic gets Full Cone NAT
        ip saddr 192.168.88.0/24 meta l4proto udp fullcone

        # TCP and all other IPv4 traffic use ordinary dynamic NAT
        ip saddr 192.168.88.0/24 masquerade
    }


    #
    # FILTER
    #

    chain input {
        type filter hook input priority filter; policy accept;

        # Do not expose router HTTP/HTTPS management on WAN
        iifname "ppp0" tcp dport { 80, 443 } drop

        # Do not expose local DNS resolver on WAN
        iifname "ppp0" udp dport 53 drop
        iifname "ppp0" tcp dport 53 drop
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
